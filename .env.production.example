# Copy this file to .env.production on a VPS, or add the same keys in your
# hosting provider dashboard. Never commit real values.

NODE_ENV=production

# Admin login bootstrap. These are used only on the first run before
# .data/admin-auth-store.json is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-live

# Supabase is optional for the current demo screens. Add these when you connect
# live database-backed user/payment data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional game aggregator launch API.
AGGREGATOR_LAUNCH_URL=
AGGREGATOR_KEY=
NEXT_PUBLIC_AGGREGATOR=

# Public site URL, useful for production references.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
